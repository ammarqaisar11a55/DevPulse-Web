# ─────────────────────────────────────────────────────────────────────────────
# DevPulse production environment: one file for the web app and the API.
#
#   cp .env.production.example .env.production   # then fill in every value
#
# .env.production is git-ignored. Never commit it.
#
# Who reads it:
#   - Web build (npm run build): only variables starting with VITE_ are copied
#     into the browser bundle. Everything else stays on the server, so never
#     give a secret a VITE_ name.
#   - API (npm start) and migrations (npm run db:deploy:prod).
# Variables set by your hosting platform take precedence over this file, so
# you can also paste these into the platform's settings instead.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════ FRONTEND (apps/web) ═══════════════════════════
# Read at BUILD time. Rebuild the web app after changing them.

# Where the browser sends API requests.
#   Same domain behind a reverse proxy (recommended): /api/v1
#   API on its own domain: https://api.devpulse.example.com/api/v1
VITE_API_URL=/api/v1


# ═════════════════════════════ BACKEND (apps/server) ═════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# fatal | error | warn | info | debug | trace | silent. Logs are JSON on stdout.
LOG_LEVEL=info

# ── Public URLs ──────────────────────────────────────────────────────────────
# Origin of the web app: used for CORS, CSRF origin checks and links in emails.
FRONTEND_URL=https://devpulse.example.com
# Origin of the API. The same as FRONTEND_URL when served from one domain.
API_URL=https://devpulse.example.com

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
# Supabase: use the "Session pooler" URI (Connect → Session pooler). The direct
# db.<project>.supabase.co host is IPv6-only and unreachable from most hosts.
# URL-encode special characters in the password (for example @ becomes %40).
# On Vercel (serverless), use the "Transaction pooler" URI instead: port 6543 with
#   ?pgbouncer=true&connection_limit=1&sslmode=require
# Run migrations (npm run db:deploy:prod) with the session pooler URI on port 5432.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── Secrets ──────────────────────────────────────────────────────────────────
# Three DIFFERENT random values, at least 32 characters each. Generate each with:
#   openssl rand -base64 48
# Changing JWT_SECRET or REFRESH_SECRET signs everyone out; changing
# PAIRING_SECRET disconnects every paired editor.
JWT_SECRET=
REFRESH_SECRET=
PAIRING_SECRET=

# ── Scheduled jobs (serverless hosts only) ─────────────────────────────────────
# Vercel Cron sends this as a bearer token to /api/v1/internal/cron/*. Leave empty
# on a long-running server, where the jobs run in-process. Generate with:
#   openssl rand -base64 48
CRON_SECRET=

# ── Token lifetimes ──────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PAIRING_KEY_TTL_MINUTES=10

# ── HTTPS and proxies ────────────────────────────────────────────────────────
# Must be true in production: the API refuses to start otherwise.
COOKIE_SECURE=true
# Number of reverse proxies or load balancers in front of the API, so client IPs
# and rate limits are correct. Usually 1.
TRUST_PROXY=1

# ── Email (password resets, email-change confirmations, security alerts) ─────
# Required in production: without SMTP_HOST, emails are only written to the log.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
EMAIL_FROM="DevPulse <no-reply@devpulse.example.com>"
