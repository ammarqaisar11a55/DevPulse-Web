# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URLs. FRONTEND_URL is used for CORS and links in emails.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse?schema=public

# ── Secrets (generate each with: openssl rand -base64 48) ─
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
REFRESH_SECRET=replace-with-a-different-long-random-string
PAIRING_SECRET=replace-with-a-third-long-random-string

# ── Token lifetimes ──────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PAIRING_KEY_TTL_MINUTES=10

# Set to true when the API is served over HTTPS (production).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs / rate limits).
TRUST_PROXY=0

# ── Email (optional in development: emails are logged when SMTP_HOST is empty) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="DevPulse <no-reply@devpulse.local>"
